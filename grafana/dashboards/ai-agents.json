    {
      "id": 10,
      "type": "table",
      "title": "Sessions",
      "description": "One row per session. Click a session id to filter the whole dashboard to it.",
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 24,
        "h": 9
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "min_over_time({service_name=~\".+\"} | agent_name=~\"$agent\" | ai_session_id=~\"${session}.*\" | ai_session_id!=\"\" | label_format ts=`{{ unixEpochMillis __timestamp__ }}` | unwrap ts [$__range]) by (agent_name, ai_session_id)",
          "queryType": "instant",
          "format": "table"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "max_over_time({service_name=~\".+\"} | agent_name=~\"$agent\" | ai_session_id=~\"${session}.*\" | ai_session_id!=\"\" | label_format ts=`{{ unixEpochMillis __timestamp__ }}` | unwrap ts [$__range]) by (agent_name, ai_session_id) - min_over_time({service_name=~\".+\"} | agent_name=~\"$agent\" | ai_session_id=~\"${session}.*\" | ai_session_id!=\"\" | label_format ts=`{{ unixEpochMillis __timestamp__ }}` | unwrap ts [$__range]) by (agent_name, ai_session_id)",
          "queryType": "instant",
          "format": "table"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum by (agent_name, ai_session_id) (count_over_time({service_name=~\".+\"} | agent_name=~\"$agent\" | ai_session_id=~\"${session}.*\" | ai_event=\"user_prompt\" [$__range]))",
          "queryType": "instant",
          "format": "table"
        },
        {
          "refId": "D",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum by (agent_name, ai_session_id) (count_over_time({service_name=~\".+\"} | agent_name=~\"$agent\" | ai_session_id=~\"${session}.*\" | ai_event=~\"tool_result|tool_call\" [$__range]))",
          "queryType": "instant",
          "format": "table"
        },
        {
          "refId": "E",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum by (agent_name, ai_session_id) (count_over_time({service_name=~\".+\"} | agent_name=~\"$agent\" | ai_session_id=~\"${session}.*\" | ai_tokens_total!=\"\" [$__range]))",
          "queryType": "instant",
          "format": "table"
        },
        {
          "refId": "F",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum by (agent_name, ai_session_id) (sum_over_time({service_name=~\".+\"} | agent_name=~\"$agent\" | ai_session_id=~\"${session}.*\" | ai_tokens_total!=\"\" | unwrap ai_tokens_total [$__range]))",
          "queryType": "instant",
          "format": "table"
        },
        {
          "refId": "G",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum by (agent_name, ai_session_id) (sum_over_time({service_name=~\".+\"} | agent_name=~\"$agent\" | ai_session_id=~\"${session}.*\" | ai_cost_usd!=\"\" | unwrap ai_cost_usd [$__range]))",
          "queryType": "instant",
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "Value #A": "Started",
              "Value #B": "Duration",
              "Value #C": "Prompts",
              "Value #D": "Tool calls",
              "Value #E": "Model calls",
              "Value #F": "Tokens",
              "Value #G": "Cost (USD)",
              "agent_name": "Agent",
              "ai_session_id": "Session"
            },
            "indexByName": {
              "agent_name": 0,
              "ai_session_id": 1,
              "Value #A": 2,
              "Value #B": 3,
              "Value #C": 4,
              "Value #D": 5,
              "Value #E": 6,
              "Value #F": 7,
              "Value #G": 8
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "Started",
                "desc": true
              }
            ]
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto"
          },
          "noValue": "\u2013"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Started"
            },
            "properties": [
              {
                "id": "unit",
                "value": "dateTimeAsLocal"
