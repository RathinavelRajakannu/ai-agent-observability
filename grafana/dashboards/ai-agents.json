    {
      "id": 6,
      "type": "stat",
      "title": "Agent wall time",
      "description": "Sum over sessions of (last event \u2212 first event).",
      "gridPos": {
        "x": 17,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum(max_over_time({service_name=~\".+\"} | agent_name=~\"$agent\" | ai_session_id=~\"${session}.*\" | ai_session_id!=\"\" | label_format ts=`{{ unixEpochMillis __timestamp__ }}` | unwrap ts [$__range]) by (ai_session_id) - min_over_time({service_name=~\".+\"} | agent_name=~\"$agent\" | ai_session_id=~\"${session}.*\" | ai_session_id!=\"\" | label_format ts=`{{ unixEpochMillis __timestamp__ }}` | unwrap ts [$__range]) by (ai_session_id))",
          "queryType": "instant"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          },
          "noValue": "0"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center"
      }
    },
    {
      "id": 7,
      "type": "stat",
      "title": "Cost (USD, Claude)",
      "description": "Only Claude Code reports cost; other agents report tokens only.",
      "gridPos": {
        "x": 21,
        "y": 1,
        "w": 3,
        "h": 4
