          "expr": "sum(sum_over_time({service_name=~\".+\"} | agent_name=~\"$agent\" | ai_session_id=~\"${session}.*\" | ai_cost_usd!=\"\" | unwrap ai_cost_usd [$__range]))",
          "queryType": "instant"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          },
          "noValue": "0",
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center"
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Tokens by agent",
      "description": "Tokens processed per interval, stacked by agent.",
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
