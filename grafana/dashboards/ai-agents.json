      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum by (agent_name) (sum_over_time({service_name=~\".+\"} | agent_name=~\"$agent\" | ai_session_id=~\"${session}.*\" | ai_tokens_total!=\"\" | unwrap ai_tokens_total [$__interval]))",
          "queryType": "range",
          "legendFormat": "{{agent_name}}"
        }
      ],
      "interval": "1m",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 2,
            "fillOpacity": 85,
            "barAlignment": 0,
            "stacking": {
              "mode": "normal"
            },
            "showPoints": "always",
            "pointSize": 6,
            "spanNulls": false,
            "axisSoftMin": 0
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "claude-code"
            },
            "properties": [
              {
                "id": "color",
